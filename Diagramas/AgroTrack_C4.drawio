  <diagram id="bk" name="Nivel 3. Componentes - Backend">
    <mxGraphModel dx="2631" dy="1438" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1430" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bk-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#1F1F1F;" value="&lt;b&gt;AgroTrack – Diagrama de componentes: API Backend&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1200" x="20" y="12" as="geometry" />
        </mxCell>
        <mxCell id="bk-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#555555;" value="Modelo C4 · Nivel 3" vertex="1">
          <mxGeometry height="22" width="1200" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="bk-b" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#444444;strokeWidth=1.5;fontColor=#1F1F1F;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;fontSize=12;" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Backend&lt;/b&gt;&lt;br&gt;[Container: Spring Boot 4.1 + Java 27]" vertex="1">
          <mxGeometry height="880" width="1650" x="30" y="300" as="geometry" />
        </mxCell>
        <mxCell id="bk-monitoreo" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Monitoreo&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System: Google Cloud Monitoring + Cloud Logging]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Recibe métricas y logs del backend, los muestra en paneles y envía alertas (también de presupuesto).&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bk-app" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2874BA;strokeColor=#1D5A91;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Aplicación móvil&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: React Native + TypeScript]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;App Android offline-first para registrar, consultar y analizar fincas, cultivos, producción, ingresos y gastos.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="510" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bk-cloudflare" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cloudflare&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;WAF, mitigación DDoS, terminación TLS y rate limiting. Protege el backend: solo le pasa tráfico con el encabezado secreto de origen.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="940" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bk-firebase" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fontSize=11;dashed=1;dashPattern=6 4;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Firebase&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Crashlytics (crashes), Analytics (eventos de uso), Cloud Messaging (push) y App Distribution (APK a testers).&lt;br&gt;&lt;i&gt;(Planeado en ADR-021, ADR-025 y ADR-028: todavía no está en el código.)&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="1370" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bk-c15" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C15 – Observabilidad&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Spring Boot Actuator + Micrometer]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Envía métricas (endpoints, JVM, BD, sincronización) a Cloud Monitoring y logs JSON con idTraza a Cloud Logging. /actuator/health para Cloud Run.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="80" y="390" as="geometry" />
        </mxCell>
        <mxCell id="bk-c14" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C14 – Manejo de errores&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: @ControllerAdvice]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Estructura única de error con codigo, mensaje, detalles, fechaHora e idTraza.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="510" y="390" as="geometry" />
        </mxCell>
        <mxCell id="bk-c8" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C8 – API REST&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Spring Boot (controladores REST)]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Endpoints versionados (/api/v1/...). Recibe las solicitudes, valida la entrada y delega en los módulos.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="940" y="390" as="geometry" />
        </mxCell>
        <mxCell id="bk-c16" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;dashed=1;dashPattern=6 4;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C16 – Notificaciones push&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Firebase Admin SDK (planeado)]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Enviaría push cuando ocurran eventos relevantes (ADR-028). &lt;i&gt;Todavía no está en el código.&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="1370" y="390" as="geometry" />
        </mxCell>
        <mxCell id="bk-c11" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C11 – Catálogo de parámetros&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Spring Boot + JPA]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;GET /api/v1/parametros: categorías, unidades y tipos. Soporta sincronización incremental (parámetro desde).&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="80" y="680" as="geometry" />
        </mxCell>
        <mxCell id="bk-c10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C10 – Seguridad&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Spring Security + JWT]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Autenticación, autorización y refresco de tokens. Valida el JWT en cada solicitud. FiltroOrigen: solo acepta tráfico que llega por Cloudflare.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="510" y="680" as="geometry" />
        </mxCell>
        <mxCell id="bk-c13" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C13 – Caché&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Spring Cache + Caffeine]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Caché en memoria de cada instancia, con TTL de 5 minutos. Memorystore (Redis) solo si se necesita caché compartida.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="1370" y="680" as="geometry" />
        </mxCell>
        <mxCell id="bk-c9" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C9 – Módulos de dominio&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Spring Boot (monolito modular hexagonal)]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;autenticacion, catalogo, registros y sincronizacion. Cada módulo con dominio, aplicación (puertos) e infraestructura (adaptadores), ADR-032.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="940" y="970" as="geometry" />
        </mxCell>
        <mxCell id="bk-c12" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=11;" value="&lt;b style=&quot;font-size:15px&quot;&gt;C12 – Migraciones&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Flyway]&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Versiona el esquema de PostgreSQL y aplica las migraciones al arrancar el backend.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="1370" y="970" as="geometry" />
        </mxCell>
